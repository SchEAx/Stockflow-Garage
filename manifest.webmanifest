    { "name": "Genel Stok", "short_name": "Stok", "url": "/#stok", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Ekran ve Çerçeve", "short_name": "Ekran", "url": "/#ekran-cerceve", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
